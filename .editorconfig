# EditorConfig — consistent formatting across editors and OSes.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# .NET / C# uses 4-space indentation
[*.{cs,csproj,sln,props,targets}]
indent_size = 4

# Markdown allows trailing whitespace (for line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab
